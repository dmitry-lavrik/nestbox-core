{
  "name": "nestbox-core",
  "version": "0.2.1",
  "description": "NestJS-style decorators, DI container and router for Fastify + TypeBox.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "fastify",
    "nestjs",
    "typebox",
    "decorators",
    "dependency-injection",
    "ioc"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "verify": "npm run check && npm run test"
  },
  "peerDependencies": {
    "@sinclair/typebox": ">=0.34.0",
    "fastify": ">=5.0.0"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.9.3",
    "fastify": "^5.8.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
